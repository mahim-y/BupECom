# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/bup_nest?retryWrites=true&w=majority

# JWT Secret for Session Cookies
AUTH_SECRET=bup-nest-dev-secret-change-in-production-32chars

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

